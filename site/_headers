# Security headers (global) — conservative launch set.
# HSTS is intentionally NOT set here; enable it at Cloudflare only after both
# nizamok.com and www.nizamok.com serve valid HTTPS and the www→apex redirect
# is verified. A Content-Security-Policy is deferred to a post-launch task.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Asset caching.
# CSS and JS carry a ?v= query that changes on every deploy, so they can be
# cached hard: a new version is a new URL. Fonts and images are content-stable
# and get the year. Only the HTML itself must stay fresh.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/video/*
  Cache-Control: public, max-age=31536000, immutable
/assets/audio/*
  Cache-Control: public, max-age=31536000, immutable
/assets/product/*
  Cache-Control: public, max-age=31536000, immutable
/assets/covers/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
